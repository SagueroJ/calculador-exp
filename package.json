{
  "name": "calculador-exp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build:js": "esbuild jv/main.js --minify --legal-comments=none --outfile=dist/main.min.js",
    "build:css": "esbuild css/main.css --minify --outfile=dist/main.min.css",
    "build": "npm run clean && mkdir -p dist && npm run build:js && npm run build:css"
  },
  "devDependencies": {
    "esbuild": "^0.23.0"
  }
}
